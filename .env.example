# Copy to .env and adjust as needed. The Makefile picks these up automatically
# (-include .env); the app also reads DATABASE_URL from the environment.

# Production database — used by the app day to day (REPL, imports, queries,
# seeds, backups). This is where your real data lives.
DATABASE_URL=postgres://bookshelf:bookshelf@localhost:5432/bookshelf

# Dedicated dev/test database (separate postgres container on port 5433).
# Integration tests create throwaway databases here and dev migrations run
# here, so the production database is never touched by development.
BOOKSHELF_DEV_URL=postgres://bookshelf:bookshelf@localhost:5433/bookshelf_dev
